{
	"$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!main.js"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noUnusedTemplateLiteral": "error",
				"useImportType": "error"
			},
			"correctness": {
				"noUnusedVariables": "error"
			},
			"nursery": {
				"noConsole": "warn"
			}
		}
	}
}
