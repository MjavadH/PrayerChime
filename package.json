{
	"name": "prayer-chime",
	"version": "2.0.0",
	"description": "Offline Obsidian prayer times for Iranian cities",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "biome check --write .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"clean": "node -e \"require(\\\"fs\\\").rmSync(\\\"main.js\\\",{force:true});require(\\\"fs\\\").rmSync(\\\"main.js.map\\\",{force:true})\"",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"prayer-times",
		"iran",
		"persian",
		"rtl"
	],
	"author": "MjavadH",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/node": "^16.11.6",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vitest": "latest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MjavadH/prayer-chime.git"
	},
	"bugs": {
		"url": "https://github.com/MjavadH/prayer-chime/issues"
	},
	"homepage": "https://github.com/MjavadH/prayer-chime#readme",
	"contributors": [
		"MjavadH"
	]
}
