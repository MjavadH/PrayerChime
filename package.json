{
	"name": "prayer-chime",
	"version": "2.2.0",
	"description": "Offline Obsidian prayer times for Iranian cities",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "biome check --write .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"clean": "node -e \"require(\\\"fs\\\").rmSync(\\\"main.js\\\",{force:true});require(\\\"fs\\\").rmSync(\\\"main.js.map\\\",{force:true})\"",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"prayer-times",
		"PrayerChime",
		"iran",
		"persian",
		"adhan"
	],
	"author": "MjavadH",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"esbuild": "0.28.1",
		"obsidian": "^1.13.1",
		"tslib": "2.8.1",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/MjavadH/PrayerChime.git"
	},
	"bugs": {
		"url": "https://github.com/MjavadH/PrayerChime/issues"
	},
	"homepage": "https://github.com/MjavadH/PrayerChime#readme",
	"contributors": [
		"MjavadH"
	],
	"packageManager": "pnpm@11.16.0"
}
